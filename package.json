{
  "name": "global-headlines",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite next dev -p 3000",
    "collect": "node scripts/collect-articles.mjs",
    "build": "node scripts/collect-articles.mjs && next build && node scripts/gen-rss.mjs",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite next start -p 3000",
    "lint": "next lint",
    "rss": "node scripts/gen-rss.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "sql.js": "^1.14.1",
    "typescript": "^5"
  }
}
