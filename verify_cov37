const { chromium } = require("C:/Users/Administrator/node_modules/playwright");

(async () => {
  const browser = await chromium.launch({ args: ["--use-gl=swiftshader", "--no-sandbox", "--enable-webgl", "--ignore-gpu-blocklist"] });
  const page = await browser.newPage({ viewport: { width: 1280, height: 1000 }, deviceScaleFactor: 2 });
  const errors = [];
  page.on("pageerror", (e) => errors.push(String(e)));
  await page.goto("https://www.starteday.com/zh", { waitUntil: "domcontentloaded" });
  await page.waitForSelector(".sd-rot.hard", { timeout: 45000 });
  await page.waitForTimeout(6000);

  const r = await page.evaluate(() => {
    const b = document.querySelector(".sd-rot.hard");
    const bb = b.getBoundingClientRect();
    const el = document.elementFromPoint(bb.x + bb.width / 2, bb.y + bb.height / 2);
    const p = document.querySelector(".sd-panel.is-global");
    const pr = p ? p.getBoundingClientRect() : null;
    const cs = p ? getComputedStyle(p) : null;
    return {
      btn: { cls: b.className, text: b.textContent.trim(), aria: b.getAttribute("aria-label") },
      hit: el ? el.tagName + "." + String(el.className) : null,
      hitIsButton: el === b,
      panelMaxHeight: cs ? cs.maxHeight : null,
      panelBottom: pr ? Math.round(pr.bottom) : null,
      btnTop: Math.round(bb.y),
      btnBottom: Math.round(bb.bottom),
      clearance: pr ? Math.round(bb.y - pr.bottom) : null,
    };
  });
  console.log("LIVE", JSON.stringify(r, null, 2));

  const b = page.locator(".sd-rot.hard").first();
  await b.screenshot({ path: "cov37_btn.png" });
  await page.locator(".sd-foot").first().screenshot({ path: "cov37_foot.png" });

  // 真实点击（之前被 .sd-cat-fill 拦截，现在应可点）
  try {
    await b.click({ timeout: 8000 });
    await page.waitForTimeout(400);
    const off = await b.evaluate((e) => ({ cls: e.className, text: e.textContent.trim() }));
    console.log("CLICK_OFF", JSON.stringify(off));
    await b.click({ timeout: 8000 });
    await page.waitForTimeout(400);
    const on = await b.evaluate((e) => ({ cls: e.className, text: e.textContent.trim() }));
    console.log("CLICK_ON ", JSON.stringify(on));
  } catch (e) { console.log("CLICK_FAIL", String(e).split("\n")[0]); }

  console.log("ERRORS", JSON.stringify(errors.slice(0, 5)));
  await browser.close();
})().catch((e) => { console.error("FATAL", e); process.exit(1); });
